# Copy to .env for local development. Never commit .env.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=<service-role key>
# Optional: the owner id written on every row (defaults to a fixed id; set it only to keep existing data)
# APP_USER_ID=<uuid>

# ollama | hf | litellm
MODEL_BACKEND=ollama
MODEL_ID=qwen2:7b
# HF_TOKEN=<token>            # MODEL_BACKEND=hf
# OLLAMA_API_BASE=http://localhost:11434

GRADIO_USER=<username>
GRADIO_PASSWORD=<password>

# Optional: date display timezone (default UTC)
APP_TIMEZONE=America/New_York
